<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="SaaS-Accelerator-Certification" version="24.7.0" type="device">
  <diagram id="dataflow-my-new" name="Data Flow Diagram">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Data Flow Diagram — my-new SaaS Accelerator" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="840" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Customer data flows, storage locations, and protection in transit / at rest" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="55" width="800" height="24" as="geometry"/>
        </mxCell>

        <!-- User -->
        <mxCell id="user" value="Marketplace Buyer" style="shape=umlActor;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#0078D4;fontColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Flow 1: Purchase -->
        <mxCell id="flow1Label" value="Flow 1 — Subscription purchase &amp; activation" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="400" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="azPortal" value="Azure Portal /&#xa;Commercial Marketplace" style="shape=mxgraph.azure2.general.azure;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="50" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="portal" value="Customer Portal&#xa;my-new-portal&#xa;(Landing page)" style="shape=mxgraph.azure2.general.app_services;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="190" width="50" height="50" as="geometry"/>
        </mxCell>

        <!-- Security group -->
        <mxCell id="secBox" value="Identity &amp; Secrets" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#737373;fontStyle=1;startSize=24;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="220" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="entra" value="Microsoft Entra ID&#xa;Name, email, tenant ID" style="shape=mxgraph.azure2.general.active_directory;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="secBox">
          <mxGeometry x="30" y="40" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="kv" value="Key Vault my-new-kv&#xa;API secrets, conn string" style="shape=mxgraph.azure2.general.key_vaults;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="secBox">
          <mxGeometry x="130" y="40" width="50" height="50" as="geometry"/>
        </mxCell>

        <!-- App logic -->
        <mxCell id="appBox" value="Application Layer (PaaS)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E8F4FC;strokeColor=#0078D4;fontStyle=1;startSize=24;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="150" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="portalApp" value="Customer Portal&#xa;ASP.NET Core 8" style="shape=mxgraph.azure2.general.app_services;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="appBox">
          <mxGeometry x="30" y="45" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="adminApp" value="Admin Portal&#xa;my-new-admin" style="shape=mxgraph.azure2.general.app_services;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="appBox">
          <mxGeometry x="110" y="45" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="webhook" value="Webhook API&#xa;/api/AzureWebhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="appBox">
          <mxGeometry x="190" y="50" width="70" height="40" as="geometry"/>
        </mxCell>

        <!-- External Microsoft API -->
        <mxCell id="fulfill" value="Marketplace&#xa;Fulfillment API v2&#xa;+ Metering API&#xa;(Third party: Microsoft)" style="shape=mxgraph.azure2.general.azure;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="190" width="50" height="50" as="geometry"/>
        </mxCell>

        <!-- Storage -->
        <mxCell id="storeBox" value="Data at Rest" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;startSize=24;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="380" width="410" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="pgvm" value="PostgreSQL VM&#xa;my-new-pgvm (private)&#xa;Database: my-newAMPSaaSDB" style="shape=mxgraph.azure2.general.virtual_machine;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="storeBox">
          <mxGeometry x="40" y="50" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="dataStored" value="Stored customer data:&#xa;• Subscription ID, plan, quantity, status&#xa;• Marketplace tenant ID&#xa;• User display name and email (from Entra)&#xa;• Subscription activity logs&#xa;• Application configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="storeBox">
          <mxGeometry x="120" y="40" width="270" height="110" as="geometry"/>
        </mxCell>

        <!-- Flow 2: Webhook -->
        <mxCell id="flow2Label" value="Flow 2 — Marketplace webhook (change plan, suspend, unsubscribe)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="500" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="mpcWebhook" value="Commercial Marketplace" style="shape=mxgraph.azure2.general.azure;fillColor=#0078D4;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="50" height="50" as="geometry"/>
        </mxCell>

        <!-- Protection notes -->
        <mxCell id="protectBox" value="Data Protection" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E1F5E1;strokeColor=#82B366;fontStyle=1;startSize=24;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="1150" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="transit" value="In transit (public): TLS 1.2+ HTTPS for all browser, webhook, and Microsoft API calls. Marketplace tokens never displayed on landing page." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="protectBox">
          <mxGeometry x="20" y="35" width="1100" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="transit2" value="In transit (private): PostgreSQL traffic over VNet (web subnet → sql subnet, port 5432). Key Vault accessed via service endpoint / managed identity." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="protectBox">
          <mxGeometry x="20" y="60" width="1100" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="rest" value="At rest: PostgreSQL on private VM (no public IP). Secrets encrypted in Azure Key Vault. No customer data shared with non-Microsoft third parties." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="protectBox">
          <mxGeometry x="20" y="85" width="1100" height="24" as="geometry"/>
        </mxCell>

        <!-- Edges Flow 1 -->
        <mxCell id="df1" value="marketplace token&#xa;(HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="user" target="azPortal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df2" value="redirect + token&#xa;(HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="azPortal" target="portal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df3" value="OIDC login&#xa;(HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=classic;endFill=1;dashed=1;fontSize=9;" edge="1" parent="1" source="portal" target="entra">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df4" value="ID token&#xa;(name, email)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=classic;endFill=1;dashed=1;fontSize=9;" edge="1" parent="1" source="entra" target="portalApp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df5" value="client credentials&#xa;(HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="portalApp" target="fulfill">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df6" value="subscription metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="fulfill" target="portalApp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df7" value="secrets (MSI)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="kv" target="portalApp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df8" value="persist&#xa;(VNet TCP 5432)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="portalApp" target="pgvm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df9" value="persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="adminApp" target="pgvm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edges Flow 2 -->
        <mxCell id="df10" value="signed webhook payload&#xa;(HTTPS POST + JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="mpcWebhook" target="webhook">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="500"/>
              <mxPoint x="1050" y="500"/>
              <mxPoint x="1050" y="230"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="df11" value="validate JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=classic;endFill=1;dashed=1;fontSize=9;" edge="1" parent="1" source="webhook" target="entra">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="df12" value="update status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9;" edge="1" parent="1" source="webhook" target="pgvm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="thirdParty" value="External third parties receiving customer data: Microsoft only (Entra ID + Commercial Marketplace APIs). No other third-party data processors." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="760" width="1150" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
